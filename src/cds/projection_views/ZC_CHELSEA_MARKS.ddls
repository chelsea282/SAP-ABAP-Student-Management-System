
@AccessControl.authorizationCheck: #NOT_REQUIRED
@EndUserText.label: 'Marks Projection View'
@Metadata.allowExtensions: true
@Metadata.ignorePropagatedAnnotations: true

define root view entity ZC_CHELSEA_MARKS
  provider contract transactional_query
  as projection on ZI_CHELSEA_MARKS
{
  key marks_id,
      enrollment_id,
      subject_name,
      max_marks,
      marks_obtained,
      exam_date,
      CreatedAt,
      LastChangedAt,
      LocalLastChangedAt
}
